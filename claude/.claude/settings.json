{
  "model": "fable[1m]",
  "statusLine": {
    "type": "command",
    "command": "~/.local/bin/starship-claude"
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "claude-session-driver@superpowers-marketplace": true,
    "figma@claude-plugins-official": true,
    "timekeeper@cc-plugins": true,
    "supabase@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "posthog@claude-plugins-official": true,
    "workflow@cc-plugins": true,
    "backseat-design@cc-plugins": true,
    "papercuts@cc-plugins": true,
    "mattpocock-skills@mattpocock": true,
    "mattpocock-skills@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "cc-plugins": {
      "source": {
        "source": "git",
        "url": "git@github.com:TimEvans/cc-plugins.git"
      }
    },
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      }
    }
  },
  "effortLevel": "high",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "voiceEnabled": true
}
